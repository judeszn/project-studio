# Copy to .env.local (gitignored) and fill in from
# Firebase console > Project settings > Your apps > Web app > SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check: reCAPTCHA Enterprise site key for this web app.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# The App Check debug token does NOT go in this file or in .env.local.
# Put it in .env.development.local (gitignored, never loaded by `vite build`):
#   VITE_APPCHECK_DEBUG_TOKEN=<token registered under
#   Firebase console > Security > App Check > Apps > Manage debug tokens>
