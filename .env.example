# Environment variables for Project Studio. Placeholders only: never put real
# values in this file. Copy each block to the git-ignored file named above it.
# Vite reads every variable as import.meta.env.NAME.

# --- .env.local (every build) -------------------------------------------------
# Firebase console > Project settings > Your apps > Web app > SDK setup and
# configuration. Without these the on-device path runs on placeholders and
# every cloud request fails.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- .env.development.local (npm run dev only; never in a production build) ---
# An App Check debug token registered in Firebase console > App Check > Apps >
# Manage debug tokens. Left empty, the development build asks the SDK to create
# one and print it to the browser console; register that one, then set it here.
VITE_APPCHECK_DEBUG_TOKEN=

# --- .env.production.local (npm run build) ------------------------------------
# A score-based reCAPTCHA Enterprise site key from the same Google Cloud
# project, registered for this web app in App Check, with the hosting domain
# in its allowed domains. Never add localhost to it. Without it the production
# build has no App Check and every cloud request is rejected.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Optional, any build: "true" makes every AI request use a fresh, limited-use
# App Check token (replay protection). Off by default until proven on a
# preview channel.
VITE_APPCHECK_LIMITED_USE=
